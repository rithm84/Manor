MANOR_DATABASE_URL=
MANOR_SOURCE_REMOTE=manor:manor-files
RCLONE_CONFIG_MANOR_TYPE=s3
RCLONE_CONFIG_MANOR_PROVIDER=Other
RCLONE_CONFIG_MANOR_ENDPOINT=
RCLONE_CONFIG_MANOR_REGION=us-east-2
RCLONE_CONFIG_MANOR_FORCE_PATH_STYLE=true
RCLONE_CONFIG_MANOR_ACCESS_KEY_ID=
RCLONE_CONFIG_MANOR_SECRET_ACCESS_KEY=
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Restore operator only, never put these in the scheduled backup environment.
MANOR_RECOVERY_DATABASE_URL=
MANOR_RECOVERY_ISOLATED=yes
MANOR_RECOVERY_REMOTE=recovery:manor-files
MANOR_RECOVERY_SNAPSHOT=
RCLONE_CONFIG_RECOVERY_TYPE=s3
RCLONE_CONFIG_RECOVERY_PROVIDER=Other
RCLONE_CONFIG_RECOVERY_ENDPOINT=
RCLONE_CONFIG_RECOVERY_REGION=us-east-2
RCLONE_CONFIG_RECOVERY_FORCE_PATH_STYLE=true
RCLONE_CONFIG_RECOVERY_ACCESS_KEY_ID=
RCLONE_CONFIG_RECOVERY_SECRET_ACCESS_KEY=
