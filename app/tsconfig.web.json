{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true
  },
  "include": [
    "src/**/*",
    "../supabase/functions/_shared/toolCatalog.ts",
    "../supabase/functions/_shared/toolExecution.ts",
    "../supabase/functions/_shared/toolDefinitions.ts",
    "../supabase/functions/_shared/*ToolCatalog.ts",
    "../supabase/functions/_shared/fileUploadPolicy.ts"
  ]
}
