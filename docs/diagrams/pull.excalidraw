      "type": "text",
      "x": 0,
      "y": 1165,
      "width": 795.6,
      "height": 16.25,
      "text": "note_pages is always re-read, because opening a note moves last_opened_at without moving its revision.",
      "originalText": "note_pages is always re-read, because opening a note moves last_opened_at without moving its revision.",
