      "index": "b0q",
      "roundness": null
    },
    {
      "angle": 0,
      "seed": 125,
      "version": 2,
      "versionNonce": 1478967130,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 1789374813808,
      "link": null,
      "locked": false,
      "opacity": 100,
      "roughness": 1,
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "id": "text-124",
      "type": "text",
      "x": 0,
      "y": 1115,
      "width": 780,
      "height": 16.25,
      "text": "A change to job_roles also re-pulls job_stage_transitions, which carries no feed trigger of its own.",
      "originalText": "A change to job_roles also re-pulls job_stage_transitions, which carries no feed trigger of its own.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "baseline": 13,
      "containerId": null,
      "autoResize": true,
      "index": "b0r",
      "roundness": null
    },
    {
      "angle": 0,
      "seed": 126,
      "version": 2,
      "versionNonce": 275938118,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 1789374813808,
      "link": null,
      "locked": false,
      "opacity": 100,
      "roughness": 1,
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "fillStyle": "solid",
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "id": "text-125",
      "type": "text",
      "x": 0,
      "y": 1140,
      "width": 904.8,
      "height": 16.25,
      "text": "A connection error keeps the mirror serving reads; any other failure parks them on the server until a pull succeeds.",
      "originalText": "A connection error keeps the mirror serving reads; any other failure parks them on the server until a pull succeeds.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "baseline": 13,
      "containerId": null,
      "autoResize": true,
      "index": "b0s",
      "roundness": null
    },
    {
