      "id": "text-123",
      "type": "text",
      "x": 0,
      "y": 1090,
      "width": 787.8,
      "height": 16.25,
      "text": "Each page commits its own last cursor, so an interrupted pull repeats a page instead of skipping one.",
      "originalText": "Each page commits its own last cursor, so an interrupted pull repeats a page instead of skipping one.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "baseline": 13,
      "containerId": null,
