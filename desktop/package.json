{
  "name": "manor-desktop",
  "version": "0.1.0",
  "description": "Manor desktop shell (Tauri)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:staging": "tauri build --config tauri.staging.conf.json",
    "check": "cargo check",
    "fmt": "cargo fmt --check",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "test": "cargo test",
    "icon": "tauri icon icons/manor-icon-1024.png",
    "benchmark": "node benchmark.mjs",
    "release": "node release.mjs --env production",
    "release:staging": "node release.mjs --env staging"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
